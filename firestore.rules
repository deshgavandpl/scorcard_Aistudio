rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read and write access for all cricket scoring, match, tournament, and team data
    match /matches/{matchId} {
      allow read, write: if true;
      
      // Match live chat subcollection
      match /chat/{chatId} {
        allow read, write: if true;
      }
    }
    
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }
    
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Global settings for social links and announcements
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Support and contact forms
    match /contacts/{contactId} {
      allow read, write: if true;
    }

    // User profiles if any
    match /users/{userId} {
      allow read, write: if true;
    }

    // Fallback default rules
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
