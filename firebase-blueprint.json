{
  "entities": {
    "Match": {
      "title": "Match",
      "description": "Cricket match data including scores and stats.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamAId": { "type": "string" },
        "teamBId": { "type": "string" },
        "teamAName": { "type": "string" },
        "teamBName": { "type": "string" },
        "tossWinnerId": { "type": "string" },
        "tossDecision": { "type": "string", "enum": ["Bat", "Bowl"] },
        "oversLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["Upcoming", "Live", "Finished"] },
        "currentInnings": { "type": "number" },
        "createdAt": { "type": "number" },
        "winnerId": { "type": "string" },
        "innings1": { "$ref": "MatchInnings" },
        "innings2": { "$ref": "MatchInnings" },
        "youtubeLiveUrl": { "type": "string" },
        "chatEnabled": { "type": "boolean" },
        "themeColor": { "type": "string" }
      },
      "required": ["id", "teamAName", "teamBName", "status", "createdAt"]
    },
    "MatchInnings": {
      "title": "MatchInnings",
      "description": "Data for a single innings of a match.",
      "type": "object",
      "properties": {
        "battingTeamId": { "type": "string" },
        "bowlingTeamId": { "type": "string" },
        "runs": { "type": "number" },
        "wickets": { "type": "number" },
        "overs": { "type": "number" },
        "balls": { "type": "number" },
        "extras": { "type": "object" },
        "battingStats": { "type": "object" },
        "bowlingStats": { "type": "object" },
        "fallOfWickets": { "type": "array" },
        "ballHistory": { "type": "array" }
      }
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Cricket tournament data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teams": { "type": "array" },
        "matches": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "Team": {
      "title": "Team",
      "description": "Cricket team data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "players": { "type": "array" }
      },
      "required": ["id", "name"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "youtube": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "website": { "type": "string" },
        "linkedin": { "type": "string" }
      }
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global announcement data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "message": { "type": "string" },
        "imageUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "message", "active"]
    },
    "FCMToken": {
      "title": "FCMToken",
      "description": "Registered FCM Token details for push notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "updatedAt": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "token", "platform", "updatedAt"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Alert logs for wickets, match outcomes and tournament results.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matchId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["wicket", "result", "event"] },
        "createdAt": { "type": "number" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "body", "type", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual chat message for a match.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string", "enum": ["text", "emoji"] }
      },
      "required": ["userId", "userName", "text"]
    }
  },
  "firestore": {
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Individual match documents."
    },
    "/matches/{matchId}/chat/{chatId}": {
      "schema": "ChatMessage",
      "description": "Chat messages collection for a match."
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Individual tournament documents."
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Individual team documents."
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global settings documents."
    },
    "/fcm_tokens/{tokenId}": {
      "schema": "FCMToken",
      "description": "Registered Device tokens for FCM notifications."
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationLog",
      "description": "Stored historical in-app notifications."
    }
  }
}
